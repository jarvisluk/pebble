{
  "defaultModel": "magpie/mac-mini/auto/hy4flash-free",
  "sharedDir": "./workspaces/_shared",
  "stateFile": "./state/sessions.json",
  "http": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3789,
    "webhookSecret": "${BOT_HUB_WEBHOOK_SECRET}",
    "apiToken": "${BOT_HUB_API_TOKEN}",
    "tailcat": { "enabled": false }
  },
  "bots": [
    {
      "id": "assistant",
      "name": "Pebble",
      "description": "日常助理：待办、日程、信息整理与日常问答",
      "workspace": "./workspaces/assistant",
      "harness": "opencode",
      "autoApprove": true,
      "timeoutSec": 300,
      "schedules": [
        {
          "name": "morning-brief",
          "dailyAt": "09:00",
          "prompt": "检查今天的重要事项与 memory/ 中的待办，给出一份简洁的晨间简报。",
          "enabled": false
        }
      ]
    },
    {
      "id": "researcher",
      "name": "Researcher",
      "description": "调研追踪：技术方案对比、资料检索与长期专题沉淀",
      "workspace": "./workspaces/researcher",
      "harness": "opencode",
      "autoApprove": true,
      "timeoutSec": 600
    }
  ]
}
